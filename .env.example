# =============================================================================
# Dcbot environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# Values marked [REQUIRED] must be set or the matching service refuses to start.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | production
NODE_ENV=development
# Set to a non-empty value to allow the bot to boot without a database
# (local smoke tests only). Production refuses to start when this is set.
ALLOW_NO_DATABASE=

# --- Discord bot [REQUIRED] --------------------------------------------------
# Single canonical variable name for the bot token. Do not introduce BOT_TOKEN.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Comma separated list of bot owner user IDs. Both IDs get identical privileges.
BOT_OWNER_IDS=1131248987173814336,1473315482554732786
# Guild ID used for fast development command registration. Leave empty to register
# commands globally (slower propagation, up to 1 hour).
DISCORD_DEV_GUILD_ID=

# --- Discord OAuth2 (dashboard) [REQUIRED for dashboard] ---------------------
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
DASHBOARD_URL=http://localhost:3000
# 32+ character random string used to sign dashboard session cookies.
SESSION_SECRET=

# --- Database [REQUIRED] -----------------------------------------------------
# PostgreSQL only. MongoDB is intentionally unsupported in this project.
DATABASE_URL=postgres://dcbot:dcbot@localhost:5432/dcbot
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Comma separated absolute paths of directories containing *.sql migrations.
MIGRATIONS_DIR=./database/migrations

# --- Redis (optional: caching, queues, distributed locks) --------------------
REDIS_URL=

# --- Music backend (optional, Lavalink v4) -----------------------------------
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
# Optional Spotify metadata resolution. This resolves track NAMES only; audio is
# played from a permitted source (e.g. YouTube) via the Lavalink search plugin.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Disable the whole music subsystem when no Lavalink node is available.
MUSIC_ENABLED=false

# --- Bot metrics API (used by the dashboard's owner panel) -------------------
# The bot serves uptime, gateway latency, memory/CPU, service health and log
# counters. It refuses to start without BOT_API_TOKEN.
BOT_API_ENABLED=false
# Loopback by default. Use 0.0.0.0 only when another container/host must reach it.
BOT_API_HOST=127.0.0.1
BOT_API_PORT=8787
# Set on the dashboard when the bot runs elsewhere, e.g. http://bot:8787
BOT_API_URL=
# Shared bearer token. Must be identical on the bot and the dashboard.
BOT_API_TOKEN=
